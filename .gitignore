# Dependencias y compilaciones
node_modules/
dist/
build/

# Artefactos y salidas temporales de los scripts
dist-packages/
mock-output/
extracted-iflows/
*.tmp
*.temp
*.bak
*.log
npm-debug.log*

# Variables de entorno y secretos locales
.env
.env.*
!.env.example

# Archivos de sistema operativo y editores
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Desarrollo interno del pack (no necesario para usar las skills)
# Suite de pruebas, fixtures, catálogo de prompts e informes de los bots de test
tests/
coverage/
.nyc_output/
*.test-output
# Documentos de trabajo del desarrollo (análisis de gaps y plan de pruebas)
docs/GAP_ANALYSIS_*.md
docs/TEST_PLAN_PROMPT.md

# Instalaciones locales generadas por setup-skills.mjs al apuntar a este mismo repo
.agents/
.claude/
.cursor/
.mcp.json

# Limpieza reversible: los mapas contienen valores originales y nunca se suben
*sanitize-map.json
*.sanitized.zip
*.restored.zip

# Artefactos SAP CPI reales o de prueba: nunca se suben (el pack genera los suyos en memoria o en tmp).
# Si algún día hace falta un ejemplo sintético versionado, añádelo a propósito con `git add -f`.
*.zip
*.iflw
*.prop
*.propdef
*.mmap
*.wsdl
*.edmx
*.xsd
*.xsl
*.xslt
*.pdf
# Carpetas de pruebas locales con exportaciones reales
realtest*/
prueba*/
