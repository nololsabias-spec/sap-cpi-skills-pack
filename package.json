{
  "name": "sap-cpi-skills-pack",
  "version": "2.0.0",
  "description": "Paquete portable de Skills Multi-IDE y Servidor MCP Local sin dependencias para SAP Cloud Integration (SAP Integration Suite / CPI).",
  "type": "module",
  "bin": {
    "sap-cpi-setup": "./setup-skills.mjs",
    "sap-cpi-mcp": "./mcp-server.mjs"
  },
  "scripts": {
    "test": "node ./verify-all.mjs",
    "verify": "node ./verify-all.mjs",
    "mcp": "node ./mcp-server.mjs",
    "install-skills": "node ./setup-skills.mjs",
    "demo:zip": "node ./skills/sap-cpi-zip-inspector/scripts/inspect-iflow-zip.mjs --demo",
    "demo:auditor": "node ./skills/sap-cpi-code-auditor/scripts/audit-groovy.mjs --demo",
    "demo:xslt": "node ./skills/sap-cpi-xslt-studio/scripts/validate-xslt.mjs --demo",
    "demo:regex": "node ./skills/sap-cpi-regex-studio/scripts/test-camel-regex.mjs --demo",
    "demo:xsd": "node ./skills/sap-cpi-xsd-studio/scripts/validate-xsd.mjs --demo",
    "demo:mock": "node ./skills/sap-cpi-mock-data-generator/scripts/pack-mock-suite.mjs --demo",
    "demo:architect": "node ./skills/sap-cpi-architect/scripts/build-cpi-package.mjs --demo",
    "demo:simulate-mmap": "node ./skills/sap-cpi-xsd-studio/scripts/simulate-mmap.mjs --demo",
    "demo:diff": "node ./skills/sap-cpi-zip-inspector/scripts/diff-iflow-zip.mjs --demo",
    "demo:doc-extract": "node ./skills/sap-cpi-architect/scripts/extract-for-docs.mjs --demo",
    "demo:api-client": "node ./skills/sap-cpi-architect/scripts/export-api-client.mjs --demo",
    "demo:value-mapping": "node ./skills/sap-cpi-architect/scripts/build-value-mapping.mjs --demo"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "sap-cpi",
    "sap-integration-suite",
    "btp",
    "groovy",
    "xslt",
    "iflow",
    "xsd",
    "camel-simple",
    "agent-skills"
  ],
  "license": "MIT"
}
